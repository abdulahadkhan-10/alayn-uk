# Restaurant app (alayn-uk) - copy to .env.local and adjust.

# Backend API (alayn-uk-api)
# Development: http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=https://api.alaynai.com/api/v1

# Standalone Supplier Portal (supplier-alayn-uk). Supplier accounts that sign in here are sent there.
# Development: http://localhost:3002
NEXT_PUBLIC_SUPPLIER_PORTAL_URL=https://suppliers.alaynai.com

# Realtime (Socket.IO) server; defaults to the API host when unset
# NEXT_PUBLIC_SOCKET_URL=https://api.alaynai.com

# Cashfree checkout: "production" for live payments, anything else uses the sandbox
NEXT_PUBLIC_CASHFREE_MODE=sandbox
